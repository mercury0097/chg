{
    "target": "esp32s3",
    "builds": [
        {
            "name": "dog",
            "sdkconfig_append": [
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m.csv\"",
                "CONFIG_LVGL_USE_GIF=y",
                "# CONFIG_SR_NSN_WEBRTC is not set",
                "CONFIG_SR_NSN_NSNET2=y",
                "# CONFIG_SR_VADN_WEBRTC is not set",
                "CONFIG_SR_VADN_VADNET1_MEDIUM=y"
            ]
        }
    ]
}








